# Local development template. Production must use infra/deploy.env.template
# and external secret injection.
MEMECHO_PROVIDER=mock
# Required before startup: generate a random token. An empty value disables auth.
MEMECHO_DEMO_TOKEN=
MEMECHO_DATA_DIR=./tmp
MEMECHO_PUBLIC_BASE_URL=http://127.0.0.1:8787

# 百炼文本模型。不同地域可使用不同的 Workspace 接入点与 Key。
BAILIAN_TEXT_BASE_URL=
BAILIAN_TEXT_API_KEY=
BAILIAN_TEXT_MODEL=qwen3.7-max-2026-06-08

# 百炼语音模型与实时 WebSocket。
BAILIAN_AUDIO_BASE_URL=
BAILIAN_AUDIO_API_KEY=
BAILIAN_REALTIME_WS_URL=
BAILIAN_REALTIME_MODEL=qwen3-asr-flash-realtime
BAILIAN_WORKSPACE_ID=
BAILIAN_REALTIME_LANGUAGE=zh
BAILIAN_REALTIME_SAMPLE_RATE=16000
BAILIAN_REALTIME_VAD_THRESHOLD=0.2
BAILIAN_REALTIME_SILENCE_DURATION_MS=800
BAILIAN_REALTIME_HEARTBEAT_SECONDS=20
BAILIAN_REALTIME_HEARTBEAT_TIMEOUT_SECONDS=20
BAILIAN_REALTIME_CLOSE_TIMEOUT_SECONDS=5
BAILIAN_REALTIME_FINISH_TIMEOUT_SECONDS=10
BAILIAN_REALTIME_MAX_FRAME_BYTES=1048576
BAILIAN_DIARIZATION_MODEL=fun-asr
BAILIAN_EMOTION_MODEL=qwen3-asr-flash-filetrans

# 私有 OSS 临时对象。
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PREFIX=memecho-tmp

