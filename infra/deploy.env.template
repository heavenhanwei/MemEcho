# memEcho Gateway production deployment template.
# Copy to a file outside source control, fill every blank, and pass it with:
# docker compose --env-file <path> -f infra/docker-compose.yml config
# Empty required values make Compose fail closed. Never commit the filled file.

# --- Compose ---
MEMECHO_IMAGE_TAG=0.1.0
MEMECHO_BIND_ADDRESS=127.0.0.1
MEMECHO_PORT=8787

# --- Gateway ---
MEMECHO_PROVIDER=bailian
# Required: generate at least 32 random bytes. Empty disables gateway auth.
MEMECHO_DEMO_TOKEN=
# Required: public HTTPS origin, without a trailing path.
MEMECHO_PUBLIC_BASE_URL=

# --- Bailian text ---
BAILIAN_TEXT_BASE_URL=
BAILIAN_TEXT_API_KEY=
BAILIAN_TEXT_MODEL=qwen3.7-max-2026-06-08

# --- Bailian audio ---
BAILIAN_AUDIO_BASE_URL=
BAILIAN_AUDIO_API_KEY=
BAILIAN_REALTIME_WS_URL=
BAILIAN_REALTIME_MODEL=qwen3-asr-flash-realtime
BAILIAN_DIARIZATION_MODEL=fun-asr
BAILIAN_EMOTION_MODEL=qwen3-asr-flash-filetrans

# --- Private temporary OSS ---
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PREFIX=memecho-tmp

# --- Limits ---
CHUNK_SIZE_BYTES=8388608
MAX_SESSION_SECONDS=7200
